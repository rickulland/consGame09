PROCEDURE TerkSpy
      (* TerkSpy1 jan01 - see TerkGame
      (*  debug modules - initial
      DIM gscan(2,64):STRING[64]
      DIM tribeN(8),playN(8),playR(12):STRING[8]
      DIM planN(6):STRING[4]
      DIM sysname,filename:STRING[80]
      DIM teststr,teststr2:STRING[16]
      DIM char:STRING[1]
      DIM dashes:STRING[28]
      DIM spaces:STRING[1]
      DIM playS(8,12),playM(8,3),playX(8),playY(8),playI(8),playC(8),playP(8),syst(6):INTEGER
      DIM tribeX(8),tribeY(8),target(8),leader(8),tint(3),rint(3),hosted(8):INTEGER
      DIM tmp,tmp0,tmp1,tmp2,testx,testy,lloop,mloop,xloop,yloop,glvl,token,rounds:INTEGER
      DIM path:BYTE
      DIM played(8),flags(3):BOOLEAN
      flags(2):=TRUE \flags(3):=FALSE
      RESTORE 9991 \ FOR lloop=1 TO 12 \ READ playR(lloop) \NEXT lloop
      RESTORE 9993 \sysname:=" "
      FOR lloop:=1 TO 6
        READ teststr,syst(lloop) \sysname:=sysname+" "+teststr
      NEXT lloop
      RESTORE 9995
      FOR lloop=1 TO 6 \ READ planN(lloop) \NEXT lloop
      teststr:="o"
      FOR xloop=2 TO 8
        teststr:=teststr+" "+LEFT$(playN(xloop),1)
      NEXT xloop
      dashes:="----------------------------" \spaces:="        "
      GOSUB 2620 \(* load game
      
 2400 LOOP 
        PRINT " Debug Page:"
        teststr:="on " \ IF flags(2)=TRUE THEN  \teststr:="off" \ ENDIF 
        teststr2:="More" \ IF flags(3)=TRUE THEN  \teststr2:="Less" \ ENDIF 
        PRINT " 1) "; teststr2; " info  2) Jump X,Y   3) Dump Galaxy   4) Dump Players  "
        PRINT " 5) Spy "; teststr; "   6) Quit    "; 
        INPUT cmd \cmd:=MOD(cmd,7)+50
        ON cmd-50 GOSUB 2410,2420,2430,2440,2450,2460
      ENDLOOP 
      
 2410 (* info flag
      IF flags(3)=TRUE THEN 
        flags(3):=FALSE
      ELSE 
        flags(3):=TRUE
      ENDIF 
      RETURN 
      
 2420 (* jump to x,y
      FOR lloop:=0 TO 4 STEP 4
        FOR xloop=1 TO 4
          PRINT "    "; lloop+xloop; " "; playN(lloop+xloop); 
        NEXT xloop
        PRINT 
      NEXT lloop
      INPUT " Player number? ",tmp1
      testx:=playX(tmp1) \testy:=playY(tmp1)
      char:=" " \glvl:=1 \ GOSUB 9000
      INPUT "Sector X: ",glxX \ INPUT "Sector Y: ",glxY
      testx:=glxX \testy:=glxY
      GOSUB 9001
      glxX:=testx \glxY:=testy
      playX(tmp1):=glxX \playY(tmp1):=glxY
      testx:=playX(tmp1) \testy:=playY(tmp1)
      char:=LEFT$(playN(tmp1),1) \ GOSUB 9001
      GOSUB 9007
      RETURN 
      
 2430 PRINT "Dump galaxy:"
      FOR yloop=1 TO 64
        IF yloop<10 THEN  \ PRINT " ";  \ ENDIF 
        PRINT yloop; " "; 
        FOR xloop=1 TO 57 STEP 8
          PRINT MID$(gscan(1,yloop),xloop,8); "|"; 
        NEXT xloop
        PRINT 
        IF flags(3)=TRUE THEN 
          PRINT "   "; 
          FOR xloop=1 TO 57 STEP 8
            FOR lloop=0 TO 7
              testx:=lloop+xloop \testy:=yloop \ GOSUB 9008
              IF tint(1)>0 THEN 
                tmp:=4
                IF tint(2)>0 THEN 
                  tmp:=6
                ELSE 
                  IF tint(3)>0 THEN  \tmp:=5 \ ENDIF 
                ENDIF 
                IF tint(2)>0 AND tint(3)>0 THEN  \tmp:=7 \ ENDIF 
              ELSE 
                IF tint(2)>0 THEN 
                  tmp:=2
                  IF tint(3)>0 THEN  \tmp:=3 \ ENDIF 
                ELSE 
                  IF tint(3)>0 THEN  \tmp:=1 \ ENDIF 
                ENDIF 
              ENDIF 
              IF tmp>0 THEN 
                char:=STR$(tmp)
              ELSE 
                char:=":"
              ENDIF 
              PRINT char; 
            NEXT lloop
            PRINT ":"; 
          NEXT xloop
        ENDIF 
        PRINT 
        IF MOD(yloop,8)=0 THEN 
          IF MOD(yloop,16)=0 THEN 
            PRINT sysname
          ELSE 
            PRINT USING "8(s9>)",playN(1),playN(2),playN(3),playN(4),playN(5),playN(6),playN(7),playN(8)
            IF flags(3)=TRUE THEN 
              PRINT "M/am - Atomic - Chemical  1) C  2) A  3) C+A  4) M  5) M+C  6) M+A  7) all"
            ENDIF 
          ENDIF 
          INPUT "q=quit ",a$
          IF a$="q" THEN  \ RETURN  \ ENDIF 
        ENDIF 
      NEXT yloop
      RETURN 
      
 2440 (* dump player status
      FOR lloop:=1 TO 8
        PRINT "----- "; playN(lloop); " at "; playX(lloop); ","; playY(lloop); "  Tribe: "; tribeN(ABS(playI(lloop))); 
        PRINT "  Plan: "; planN(playP(lloop)); 
        IF playP(lloop)=2 OR playP(lloop)=3 THEN 
          PRINT " "; playN(target(lloop))
        ELSE 
          PRINT 
        ENDIF 
        testx:=playX(lloop) \testy:=playY(lloop) \ GOSUB 9008
        PRINT spaces; "  Cargo: MAM="; tint(1); " Atm="; tint(2); " Chm="; tint(3); 
        PRINT " Stores: MAM:"; playM(lloop,1); " Atm:"; playM(lloop,2); " Chm:"; playM(lloop,3)
        PRINT spaces; 
        PRINT USING "3(s8<,i4>),s1>",playR(1),playS(lloop,1),playR(2),playS(lloop,2),playR(3),playS(lloop,3),"%"
        PRINT spaces; 
        PRINT USING "3(s8<,i4>),s1>",playR(4),playS(lloop,4),playR(5),playS(lloop,5),playR(6),playS(lloop,6),"%"
        PRINT spaces; 
        PRINT USING "3(s8<,i4>),s1>",playR(7),playS(lloop,7),playR(8),playS(lloop,8),playR(9),playS(lloop,9),"%"
        PRINT spaces; 
        PRINT USING "3(s8<,i4>),s1>",playR(10),playS(lloop,10),playR(11),playS(lloop,11),playR(12),playS(lloop,12),"%"
        IF lloop=4 OR lloop=8 THEN  \ INPUT "next ?",a$ \ ENDIF 
      NEXT lloop
      RETURN 
 2450 (* all players?
      IF flags(2)=TRUE THEN 
        flags(2):=FALSE
      ELSE 
        flags(2):=TRUE
      ENDIF 
      RETURN 
 2460 STOP 
      
 2620 (* Load/reload game
      filename:="Terk"
      PRINT "Game file to load ("; filename; ")"; 
      INPUT teststr
      IF teststr<>"" THEN  \filename:=teststr \ ENDIF 
      filename:=filename+".dat"
      PRINT  \ PRINT "Loading Game. please wait..."
      OPEN #path,filename:READ
      IF LEFT$(filename,1)="s" THEN 2625
      FOR yloop=1 TO 64 \ READ #path,gscan(1,yloop) \NEXT yloop
      FOR yloop=1 TO 64
        gscan(2,yloop):=""
        FOR mloop=1 TO 64
          READ #path,tmp
          gscan(2,yloop):=gscan(2,yloop)+CHR$(tmp)
        NEXT mloop
      NEXT yloop
 2625 (* short read insert
      READ #path,token \ READ #path,rounds
      FOR lloop=1 TO 8
        READ #path,playN(lloop) \ READ #path,playX(lloop) \ READ #path,playY(lloop)
        READ #path,playI(lloop) \ READ #path,playC(lloop) \ READ #path,playP(lloop)
        READ #path,target(lloop) \ READ #path,leader(lloop) \ READ #path,played(lloop)
        READ #path,hosted(lloop)
        READ #path,tribeN(lloop) \ READ #path,tribeX(lloop) \ READ #path,tribeY(lloop)
        FOR yloop=1 TO 12 \ READ #path,playS(lloop,yloop) \NEXT yloop
        FOR yloop=1 TO 3 \ READ #path,playM(lloop,yloop) \NEXT yloop
      NEXT lloop
      CLOSE #path
      RETURN 
      
      (* Utility Stuffs ---------------
      
 9000 (* string concat
      gscan(glvl,testy):=LEFT$(gscan(glvl,testy),testx-1)+char+MID$(gscan(glvl,testy),testx+1,64)
      RETURN 
      
 9001 (* step right until clear
      testx:=testx-1
      LOOP 
        testx:=testx+1
        IF testx>64 THEN  \testx:=1 \testy:=testy+1 \ ENDIF 
        IF testy>64 THEN  \testy:=1 \ ENDIF 
      EXITIF MID$(gscan(1,testy),testx,1)=" " THEN 
      ENDEXIT 
      ENDLOOP 
      RETURN 
      
 9007 quadX:=INT((testx-1)/8+1) \quadY:=INT((testy-1)/8+1)
      RETURN 
      
 9008 (* read resouce layer
      tmp:=ASC(MID$(gscan(2,testy),testx,1)) \tint(1):=INT(tmp/100)
      tmp:=tmp-tint(1)*100 \tint(2):=INT(tmp/10) \tint(3):=tmp-tint(2)*10
      RETURN 
      
 9990 DATA "nimbus",-2,"wayfarer",-1,"hrtgold",-1,"axiom",-2,"eagle5",-3,"mfalcon",-3,"tardis7",-4
 9991 DATA "  Warp: ","% Impls:","%   RCS:","  Main: ","%   APU: ","%  Batt:","% Plse:","%  Torp:","% Miner:","  Shld: ","%  Envr:","% Consu:"
 9992 DATA "Antimatter (Warp, Main Pwr, Pulse, Shields)","Atomics (Impls, APU Pwr, Torpedos, Enviro)"
      DATA "Chemical (React, Batt Pwr, Mining, Consumable)"
 9993 DATA "*:nude star",350,"o:preciv",45,"@:suborbital",24,"O:orbital",8,"Q:galactic",4,"#:bases",4
 9994 DATA " Books"," Toons"," Film"," Human"
 9995 DATA "SRVY","CHSE","LEAD","WING","RTB ","    "
