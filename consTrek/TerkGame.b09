PROCEDURE consGame
      (* TerkGame mar2 - terminal game for Basic09
      (* play debug & balance: damage control
      
      DIM gscan(2,64):STRING[64]
      DIM fscan(3):STRING[32]
      DIM tscan(2,8),tribeN(8),playN(8),playR(12):STRING[8]
      DIM tstr(4),planN(6):STRING[4]
      DIM prnstr,sysname,trbname,filename:STRING[80]
      DIM dashes:STRING[28]
      DIM teststr2,teststr:STRING[16]
      DIM spaces:STRING[8]
      DIM char:STRING[1]
      DIM random(3),dist,dist0,dtmp1,dtmp2,glxX,glxY:REAL
      DIM playS(8,12),playM(8,3),hosted(8):INTEGER
      DIM playX(8),playY(8),tribeX(8),tribeY(8),playI(8),playC(8),playP(8),syst(6):INTEGER
      DIM comp(8),range(8),target(8),leader(8),pint(3),qint(3),rint(3),sint(3),tint(3):INTEGER
      DIM tmp,tmp0,tmp1,tmp2,tmp3,tmp4,scanx,scany,testx,testy,tmpX,tmpY:INTEGER
      DIM randl,rlmt,lloop,mloop,xloop,yloop,cmd,cmd0,pin,tcnt,rounds:INTEGER
      DIM quadX,quadY,me,play,dmax,glvl,targ,targ0,token,xstep,ystep:INTEGER
      DIM flags(6),played(8):BOOLEAN
      DIM path:BYTE
      flags(1):=FALSE \flags(2):=TRUE \flags(3):=FALSE
      flags(4):=TRUE \flags(5):=FALSE \flags(6):=FALSE
      (* flags(2):=FALSE
      RESTORE 9991 \ FOR lloop=1 TO 12 \ READ playR(lloop) \NEXT lloop
      RESTORE 9993 \sysname:=" "
      FOR lloop:=1 TO 6
        READ teststr,syst(lloop) \sysname:=sysname+" "+teststr
      NEXT lloop
      RESTORE 9995
      FOR lloop=1 TO 6 \ READ planN(lloop) \NEXT lloop
      tmp0:=0 \tmp:=RND(-1) \(* obfuscate RNG
      tmp:=VAL(MID$(DATE$,13,2)) \tmp:=tmp+VAL(MID$(DATE$,16,2))
      FOR lloop=1 TO tmp \tmp0:=RND(0) \NEXT lloop
      teststr:="o" \me:=1 \(* FIXME  me not always site 1
      FOR xloop=2 TO 8
        teststr:=teststr+" "+LEFT$(playN(xloop),1)
      NEXT xloop
      dashes:="----------------------------" \spaces:="        "
      GOSUB 2620 \(* load game
      
 1000 (* play loop 
      glvl:=1 \testx:=playX(me) \testy:=playY(me) \ GOSUB 9007
      PRINT  \ PRINT  \ PRINT 
      LOOP 
        FOR lloop=1 TO 8
          IF played(lloop)=FALSE THEN 1010
        NEXT lloop
        IF flags(3)=TRUE THEN 
          (* debug  tracker files
          PRINT "--- end round "; rounds; " ---"; 
          CREATE #path,"s"+STR$(rounds)+".dat":WRITE
          GOSUB 2615
          INPUT a$
          
        ENDIF 
        rounds:=rounds+1
        FOR lloop=1 TO 8
          played(lloop):=FALSE
        NEXT lloop \(* fall into 1010
 1010   LOOP 
          token:=INT(RND(8)+1)
        EXITIF played(token)=FALSE THEN 
          played(token):=TRUE \randl:=0
          FOR lloop:=1 TO 3 \random(lloop):=RND(0)*1.0E+09 \NEXT lloop
        ENDEXIT 
        ENDLOOP 
 1020   IF playI(token)<0 THEN 
          GOSUB 3000 \ GOTO 1070
        ENDIF 
        IF token<>me THEN 1060
        glxX:=playX(me) \glxY:=playY(me) \testx:=glxX \testy:=glxY \ GOSUB 9007
        FOR lloop=1 TO 3 \fscan(lloop):=" " \NEXT lloop
        tcnt:=1
        FOR yloop=1 TO 8
          playC(yloop):=0
          FOR lloop=1 TO 12
            IF playS(yloop,lloop)<0 THEN  \playS(yloop,lloop):=0 \ ENDIF 
            IF playS(yloop,lloop)>100 THEN  \playS(yloop,lloop):=100 \ ENDIF 
            playC(yloop):=playC(yloop)+playS(yloop,lloop)
          NEXT lloop
        NEXT yloop
        GOSUB 9011
 1030   (* long scan
        FOR tmpY=quadY-1 TO quadY+1
          FOR tmpX=quadX-1 TO quadX+1
            IF tmpX<1 OR tmpX>8 OR tmpY<1 OR tmpY>8 THEN 
              fscan(tcnt):=fscan(tcnt)+"****** "
            ELSE 
              tmp1:=0 \tmp2:=0 \tmp3:=0 \glxX:=tmpX*8-7 \glxY:=tmpY*8-7
              FOR lloop=1 TO 8
                tscan(1,lloop):=MID$(gscan(1,glxY),glxX,8) \glxY:=glxY+1
              NEXT lloop
              FOR yloop=1 TO 8
                FOR xloop=1 TO 8
                  char:=MID$(tscan(1,yloop),xloop,1)
                  IF SUBSTR(char,"*o@")>0 THEN  \tmp1:=tmp1+1 \ ENDIF
                  IF SUBSTR(char,"#OQ")>0 THEN  \tmp2:=tmp2+1 \ ENDIF
                  IF ASC(char)>96 AND ASC(char)<122 THEN  \tmp3:=tmp3+1 \ ENDIF 
                NEXT xloop
              NEXT yloop
              IF tmp1<10 THEN  \fscan(tcnt):=fscan(tcnt)+" " \ ENDIF
              fscan(tcnt):=fscan(tcnt)+STR$(tmp1)+"."+STR$(tmp2)
              fscan(tcnt):=fscan(tcnt)+"."+STR$(tmp3)+" "
            ENDIF 
          NEXT tmpX
          tcnt:=tcnt+1
        NEXT tmpY
 1050   (* short scan
        PRINT  \ PRINT spaces; "Quad: "; quadX; ","; quadY; 
        PRINT spaces; spaces; "Nearby Quads: *o@.#OQ.other" \glvl:=1
        FOR lloop=1 TO 8
          testx:=playX(lloop) \testy:=playY(lloop) \char:=LEFT$(playN(lloop),1) \ GOSUB 9000
        NEXT lloop
        tcnt:=1 \glxX:=quadX*8-7 \glxY:=quadY*8-7 \(* top left
        FOR yloop=glxY TO glxY+7
          tscan(1,tcnt):=MID$(gscan(1,yloop),glxX,8) \tcnt:=tcnt+1
        NEXT yloop
        PRINT dashes
        FOR yloop=1 TO 8
          PRINT "|  "; 
          FOR xloop=1 TO 8
            PRINT MID$(tscan(1,yloop),xloop,1); "  "; 
          NEXT xloop
          PRINT "|"; 
          IF yloop=1 THEN  \ PRINT spaces; fscan(1) \ ENDIF 
          IF yloop=2 THEN  \ PRINT spaces; fscan(2) \ ENDIF 
          IF yloop=3 THEN  \ PRINT spaces; fscan(3) \ ENDIF 
          IF yloop=4 THEN  \ PRINT  \ ENDIF 
          IF yloop=5 THEN 
            PRINT USING "3(s8<,i4>),s1>",playR(1),playS(me,1),playR(2),playS(me,2),playR(3),playS(me,3),"%"
          ENDIF 
          IF yloop=6 THEN 
            PRINT USING "3(s8<,i4>),s1>",playR(4),playS(me,4),playR(5),playS(me,5),playR(6),playS(me,6),"%"
          ENDIF 
          IF yloop=7 THEN 
            PRINT USING "3(s8<,i4>),s1>",playR(7),playS(me,7),playR(8),playS(me,8),playR(9),playS(me,9),"%"
          ENDIF 
          IF yloop=8 THEN 
            PRINT USING "3(s8<,i4>),s1>",playR(10),playS(me,10),playR(11),playS(me,11),playR(12),playS(me,12),"%"
          ENDIF 
        NEXT yloop
        PRINT dashes \glxX:=playX(me) \glxY:=playY(me)
        PRINT  \ PRINT "Next Screen: "; 
        PRINT " 1)Engine  2)Effector  3)Intel  4)Damage  5)Settings"; 
        INPUT cmd \cmd:=MOD(cmd,6)
        IF cmd=0 THEN 1050
 1060   ON cmd GOSUB 2000,2100,2200,2300,2600
        IF flags(4)=FALSE THEN  \flags(4):=TRUE \ GOTO 1060 \ ENDIF
 1070 ENDLOOP 
      
 2000 (* engines
      testx:=playX(token) \testy:=playY(token) \(* lift player
      glxX:=testx \glxY:=testy \ GOSUB 9013 \ GOSUB 9007
      INPUT " 1) Warp   2) Impulse ",cmd \cmd:=MOD(cmd,3)+10
      PRINT spaces; "   autonav:" \ GOSUB 9100
      IF MID$(gscan(1,glxY),glxX,1)<>" " THEN 
        IF SUBSTR(char,"*o@OQ")>0 THEN 
          rlmt:=30 \tmp0:=me \tmp1:=1 \tmp2:=2 \ GOSUB 9005
        ENDIF 
        IF ASC(char)>96 AND ASC(char)<122 THEN 
          (* hit player
          rlmt:=20 \ GOSUB 9010
          playS(me,10):=playS(me,10)-randl \(* local damage
          GOSUB 9002 \(* player damage
        ENDIF 
        testx:=playX(token) \testy:=playY(token)
        GOSUB 9001 \(* get clear of collision
        playX(token):=testx \playY(token):=testy
      ENDIF 
      GOSUB 9014
      playX(token):=testx \playY(token):=testy \(* drop player
      RETURN 
      
 2100 PRINT "   Effector:"
      tmpX:=quadX \tmpY:=quadY
      INPUT " 1) Pulse   2) Torpedo   3) Miner ",cmd
      cmd:=MOD(cmd,4)+20
      IF cmd=20 THEN  \flags(4):=FALSE \ RETURN  \ ENDIF 
      IF cmd=21 THEN  \(* Pulse - range around endpoint
        glxX:=playX(target(token)) \glxY:=playY(target(token))
        GOSUB 9100
        FOR yloop=glxY-1 TO glxY+1
          FOR xloop=glxX-1 TO glxY-1
            char:=MID$(gscan(1,yloop),xloop,1)
            IF char<>" " THEN 
              GOSUB 9002 \(* phaser hit
            ENDIF 
          NEXT xloop
        NEXT yloop
      ENDIF 
      IF cmd=22 THEN  \(* ranged weapon 
        glxY:=playY(token) \glxX:=playX(token)
        GOSUB 9100
        char:=MID$(gscan(1,glxY),glxX,1)
        IF SUBSTR(char,"abcdefghijklmnpqrstuvwxyz")>0 THEN 
          GOSUB 9002 \(* ranged hit 
        ENDIF 
      ENDIF 
      IF cmd=23 THEN 
        glxY:=playY(token) \glxX:=playX(token) \ GOSUB 9100
        testx:=glxX \testy:=glxY \ GOSUB 9008
        tmp:=ASC(MID$(gscan(2,playY(token)),playX(token),1)) \rint(1):=INT(tmp/100)
        tmp:=tmp-rint(1)*100 \rint(2):=INT(tmp/10) \rint(3):=tmp-rint(2)*10
        PRINT "Recoverable matl:    1) M/AM="; tint(1); "    2) Atom="; tint(2); "    3) Chem="; tint(3)
        INPUT "   Select one:",tmp
        tmp:=MOD(tmp,4) \ IF tmp=0 THEN  \ RETURN  \ ENDIF 
        tmp0:=6 \ IF tmp1=1 THEN  \tmp0:=3 \ ENDIF 
        FOR mloop=1 TO 5
          IF tint(tmp)>0 AND tint(tmp)+rint(tmp)<tmp0 THEN 
            tint(tmp):=tint(tmp)-1 \rint(tmp):=rint(tmp)+1
          ENDIF 
        NEXT mloop
        tmp:=tint(1)*100+tint(2)*10+tint(3)
        glvl:=2 \char:=CHR$(tmp) \testx:=glxX \testy:=glxY \ GOSUB 9000
        tmp:=rint(1)*100+rint(2)*10+rint(3)
        glvl:=2 \char:=CHR$(tmp) \testx:=playX(token) \testy:=playY(token) \ GOSUB 9000
        glvl:=1 \testx:=playX(token) \testy:=playY(token) \ GOSUB 9000
        testx:=playX(token) \testy:=playY(token) \ GOSUB 9008
        PRINT "   Cargo: MAM="; tint(1); " Atm="; tint(2); " Chm="; tint(3) \ PRINT 
      ENDIF 
      RETURN 
 2200 PRINT "  Intel:"
      teststr:="on " \ IF flags(1)=TRUE THEN  \teststr:="off" \ ENDIF
      PRINT " 1) Qprobe  2) Qscan  3) Scores  4) Legend"; teststr; 
      INPUT " ",cmd
      cmd:=MOD(cmd,5)+30
      IF cmd=30 THEN  \ RETURN  \ ENDIF 
      ON cmd-30 GOSUB 2210,2210,2220,2230
      RETURN 
 2210 (* probes
      glxX:=playX(token) \glxY:=playY(token) \glvl:=cmd-30
      GOSUB 9100
      IF track<dist THEN 
        PRINT "probe destroyed."
        RETURN 
      ENDIF 
      IF scanx=quadX OR scany=quadY THEN  \flags(4):=FALSE \ ENDIF
      testx:=glxX \testy:=glxY \ GOSUB 9007
      tmp1:=me \scanx:=quadX \scany:=quadY
      tcnt:=1 \glxX:=quadX*8-7 \glxY:=quadY*8-7
      FOR yloop=glxY TO glxY+7
        tscan(1,tcnt):=MID$(gscan(1,yloop),glxX,8)
        tscan(2,tcnt):=MID$(gscan(2,yloop),glxX,8) \tcnt:=tcnt+1
      NEXT yloop
      FOR yloop=1 TO 8
        FOR xloop=1 TO 8
          IF cmd=31 THEN 
            char:=MID$(tscan(1,yloop),xloop,1)
            IF SUBSTR(char," *o@#")>0 THEN 
              tmp0:=yloop \tmp1:=xloop
              glvl:=1 \ GOSUB 2211
            ELSE 
              char:="."
              rlmt:=8 \ GOSUB 9010
              tmp0:=yloop+INT(randl-4)
              IF tmp0<1 THEN  \tmp0:=1 \ ENDIF 
              IF tmp0>8 THEN  \tmp0:=8 \ ENDIF 
              rlmt:=9 \randl:=0 \ GOSUB 9010
              tmp1:=xloop+INT(randl-4)
              IF tmp1<1 THEN  \tmp1:=1 \ ENDIF 
              IF tmp1>8 THEN  \tmp1:=8 \ ENDIF 
              glvl:=1 \ GOSUB 2211
            ENDIF 
          ELSE 
            char:=MID$(tscan(2,yloop),xloop,1)
            tmp0:=yloop \tmp1:=xloop
            glvl:=2 \ GOSUB 2211
          ENDIF 
        NEXT xloop
      NEXT yloop
      tcnt:=1
      FOR lloop=1 TO 8
        comp(lloop):=0
        tmp:=ABS(playX(lloop)-glxX)+ABS(playY(lloop)-glxY)
        IF tmp<16 THEN 
          comp(tcnt):=lloop \tcnt:=tcnt+1
        ENDIF 
      NEXT lloop
      IF cmd=31 OR cmd=32 THEN 
        PRINT  \ PRINT " Quadrant "; quadX; " "; quadY; 
        IF cmd=31 THEN 
          PRINT spaces; spaces; "Suspected nearby: "
        ELSE 
          PRINT sysname \ PRINT spaces; " number(no leading 0): m/am nuke chem "
        ENDIF 
        IF cmd=32 THEN  \ PRINT "  "; dashes;  \ ENDIF 
        PRINT dashes
        FOR yloop=1 TO 8
          PRINT "| "; 
          FOR xloop=1 TO 8
            PRINT MID$(tscan(1,yloop),xloop,1); "  "; 
            IF cmd=32 THEN 
              tmp:=ASC(MID$(tscan(2,yloop),xloop,1))
              IF tmp=0 THEN 
                PRINT "   "; 
              ELSE 
                IF tmp<100 THEN  \ PRINT " ";  \ ENDIF 
                IF tmp<10 THEN  \ PRINT " ";  \ ENDIF 
                PRINT tmp; 
              ENDIF 
              PRINT ":"; 
            ENDIF 
          NEXT xloop
          PRINT " |    "; 
          IF cmd=32 THEN  \ PRINT  \ ENDIF 
          IF cmd=31 AND comp(yloop)>0 AND RND(10)<5 THEN 
            IF comp(yloop)<>me THEN 
              PRINT playN(comp(yloop)); 
            ENDIF 
          ENDIF 
          PRINT 
        NEXT yloop
        IF cmd=32 THEN  \ PRINT "  "; dashes;  \ ENDIF 
        PRINT dashes
      ENDIF 
      INPUT "next ",a$
      glxX:=playX(token) \glxY:=playY(token)
      testx:=glxX \testy:=glxY \ GOSUB 9007
      RETURN 
 2211 teststr:=LEFT$(tscan(glvl,tmp0),tmp1-1)+char
      tscan(glvl,yloop):=teststr+MID$(tscan(glvl,tmp0),tmp1+1,8)
      RETURN 
 2220 (* player scores FIXME
      FOR lloop=1 TO 8
        PRINT "----- "; playN(lloop); "  Tribe: "; tribeN(ABS(playI(lloop)))
        PRINT "  Vessel: "; playC(lloop); "  Cargo:  "; 
        PRINT ASC(MID$(gscan(2,playY(lloop)),playX(lloop),1)); 
        PRINT USING "2(s8<,i4>),s1>",playR(1),playS(lloop,1),playR(2),playS(lloop,2); "%"
        PRINT 
      NEXT lloop
      INPUT a$
      RETURN 
 2230 (* Legend flag
      IF flags(1)=TRUE THEN  \flags(1):=FALSE
      ELSE  \flags(1):=TRUE
      ENDIF 
      flags(4):=FALSE
      RETURN 
 2300 PRINT "  Damage Control:"
      FOR mloop=1 TO 3 \qint(mloop):=0 \rint(mloop):=0 \NEXT mloop \flags(4):=FALSE
      IF playI(token)<0 THEN 
        FOR mloop=1 TO 3
          tint(mloop):=playM(token,mloop)
          IF tint(mloop)>34 THEN  \tint(mloop):=34 \ ENDIF 
        NEXT mloop
      ELSE 
        IF token=me THEN 
          PRINT " Matl in stock: MAM:"; playM(me,1); " Atm:"; playM(me,2); " Chm:"; playM(me,3)
          testx:=playX(me) \testy:=playY(me) \ GOSUB 9008
          PRINT " Cargo in hold:   MAM:"; tint(1); " Atm:"; tint(2); " Chm:"; tint(3)
          INPUT " Configure for: 1) Repair   2) Refine ",a$
          flags(5):=TRUE \ IF a$="2" THEN  \flags(5):=FALSE \ ENDIF
          RESTORE 9992
          FOR mloop=1 TO 3
            qint(mloop):=0 \ PRINT "Divide 100 units time between 3 classes:"
            READ prnstr \ PRINT "   "; prnstr;  \ INPUT qint(mloop)
            tmp0:=qint(1)+qint(2)+qint(3)
            IF qint(mloop)>0 THEN 
              IF tmp0>100 THEN  \qint(mloop):=qint(mloop)-(tmp0-100) \ ENDIF 
              flags(4):=TRUE \ GOSUB 2305
            ENDIF 
          NEXT mloop
        ENDIF 
      ENDIF 
      RETURN 
 2305 (* do work
      FOR mloop=1 TO 3
        IF flags(5)=TRUE THEN  \(* repair
          playM(token,mloop):=playM(token,mloop)-qint(mloop)
          LOOP 
            FOR yloop=mloop TO mloop+10 STEP 3
              IF playS(token,yloop)<100 THEN 
                IF qint(mloop)>0 THEN 
                  playS(token,yloop):=playS(token,yloop)+3 \(* set DC spd
                ENDIF 
              ENDIF 
              qint(mloop):=qint(mloop)-1
            NEXT yloop
          EXITIF qint(mloop)<1 THEN 
          ENDEXIT 
          ENDLOOP 
        ELSE 
          FOR yloop=1 TO qint(mloop)
            IF MOD(qint(mloop),9)=0 THEN  \(* set stat pts per mined
              tint(mloop):=tint(mloop)-1
            ENDIF 
            IF tint(mloop)>0 THEN 
              playM(token,mloop):=playM(token,mloop)+1
              IF playM(token,mloop)>100 THEN  \playM(token,mloop):=100 \ ENDIF 
              testx:=playX(token) \testy:=playY(token) \ GOSUB 9009 \(* write resc
            ENDIF 
          NEXT yloop
        ENDIF 
      NEXT mloop
      RETURN 
 2440 (* debug section
      RETURN 
 2500 (* systems damage/wear  in: play, cmd0, targ0, dist0
      dist0:=INT(dist/64)
      cmd0:=MOD(cmd0,4)+60
      IF cmd0=60 THEN  \ RETURN  \ ENDIF 
      ON cmd0-60 GOSUB 2510,2520,2530
      RETURN 
 2510 (* turn: manage storage
      FOR xloop:=1 TO 3
        IF playS(play,xloop)>0 THEN 
          playS(play,xloop+3):=playS(play,xloop+3)+playS(play,xloop)/20 \(* charge
        ELSE 
          playS(play,xloop+3):=playS(play,xloop+3)-playS(play,xloop+3)/20
        ENDIF 
      NEXT xloop
      RETURN 
 2520 (* use: one device, plus a turn also passes
      IF targ0>6 THEN 
        tmp:=3
        IF targ0>9 THEN  \tmp:=6 \ ENDIF 
        playS(play,targ0-tmp):=playS(play,targ0-tmp)-dist0/20
      ENDIF 
      playS(play,targ0):=playS(play,targ0)-dist0/20
      (* GOSUB 2510
      RETURN 
 2530 (* damage: repeat as needed 
      IF playS(play,10)>10 THEN 
        playS(play,10):=playS(play,10)-dist0
        dist0:=dist0-playS(play,10)/20 \(* set dmg offset by shields
      ENDIF 
      playS(play,targ0):=playS(play,targ0)-dist0
      RETURN 
 2600 (* system settings
      PRINT " 1)Save  2)Load  3)Leave  4) Network"; 
      INPUT cmd0 \cmd0:=MOD(cmd0,4)+70
      ON cmd0-70 GOSUB 2610,2620,2630,2640
      RETURN 
 2610 (* save game
      filename:="Terk"
      PRINT "What is the name of this game ("; filename; ")"; 
      INPUT teststr
      IF teststr<>"" THEN  \filename:=teststr \ ENDIF 
      ON ERROR GOTO 2611
      SHELL "del "+filename+".map"
      SHELL "del "+filename+".dat"
 2611 ON ERROR 
      PRINT  \ PRINT "Preserving Galaxy. please wait..."
      CREATE #path,filename+".map":WRITE
      FOR xloop=1 TO 2
        FOR yloop=1 TO 64
          FOR mloop=1 TO 64
            tmp:=ASC(MID$(gscan(xloop,yloop),mloop,1))
            WRITE #path,tmp
          NEXT mloop
          PRINT "."; 
        NEXT yloop
      NEXT xloop
      PRINT  \ CLOSE #path
      CREATE #path,filename+".dat":WRITE
 2615 (* short save entry point
      WRITE #path,token \ WRITE #path,rounds
      FOR lloop=1 TO 8
        WRITE #path,playN(lloop) \ WRITE #path,playX(lloop) \ WRITE #path,playY(lloop)
        WRITE #path,playI(lloop) \ WRITE #path,playC(lloop) \ WRITE #path,playP(lloop)
        WRITE #path,target(lloop) \ WRITE #path,leader(lloop) \ WRITE #path,played(lloop)
        WRITE #path,hosted(lloop)
        WRITE #path,tribeN(lloop) \ WRITE #path,tribeX(lloop) \ WRITE #path,tribeY(lloop)
        FOR yloop=1 TO 12 \ WRITE #path,playS(lloop,yloop) \NEXT yloop
        FOR yloop=1 TO 3 \ WRITE #path,playM(lloop,yloop) \NEXT yloop
      NEXT lloop
      CLOSE #path
      PRINT " File saved."
      RETURN 
 2620 (* Load/reload game
      filename:="Terk"
      PRINT "Game file to load ("; filename; ")"; 
      INPUT teststr
      IF teststr<>"" THEN  \filename:=teststr \ ENDIF 
      PRINT  \ PRINT "Loading Game. please wait..."
      OPEN #path,filename+".map":READ
      FOR xloop=1 TO 2
        PRINT 
        FOR yloop=1 TO 64
          PRINT "."; 
          gscan(xloop,yloop):=""
          FOR mloop=1 TO 64
            READ #path,tmp \gscan(xloop,yloop):=gscan(xloop,yloop)+CHR$(tmp)
          NEXT mloop
        NEXT yloop
      NEXT xloop
      PRINT 
      CLOSE #path
      OPEN #path,filename+".dat":READ
      READ #path,token \ READ #path,rounds
      FOR lloop=1 TO 8
        READ #path,playN(lloop) \ READ #path,playX(lloop) \ READ #path,playY(lloop)
        READ #path,playI(lloop) \ READ #path,playC(lloop) \ READ #path,playP(lloop)
        READ #path,target(lloop) \ READ #path,leader(lloop) \ READ #path,played(lloop)
        READ #path,hosted(lloop)
        READ #path,tribeN(lloop) \ READ #path,tribeX(lloop) \ READ #path,tribeY(lloop)
        FOR yloop=1 TO 12 \ READ #path,playS(lloop,yloop) \NEXT yloop
        FOR yloop=1 TO 3 \ READ #path,playM(lloop,yloop) \NEXT yloop
      NEXT lloop
      CLOSE #path
      RETURN 
 2630 (* Leave game
      RETURN 
 2640 (* Network Settings
      RETURN 
      
 3000 (* AI players 
      glxX:=playX(token) \glxY:=playY(token)
      prnstr:=LEFT$(tribeN(ABS(playI(token))),1)+":"+playN(token)+" "
      FOR mloop=1 TO 3 \(* run DC
        IF playS(token,mloop)<75 THEN  \(* set DC lmt
          IF flags(2)=TRUE THEN 
            PRINT playN(token); " runs DC: "
          ENDIF 
          tint(mloop):=playM(token,mloop)
          IF tint(mloop)>14 THEN  \(* set repair matl thold
            FOR lloop=mloop TO mloop+9 STEP 3
              IF playS(token,lloop)<90 THEN 
                tmp0:=90-playS(token,lloop)
                tmp1:=tint(mloop)-tmp0 \(* matl left
                IF tmp1<0 THEN  \tmp0:=tmp0+tmp1 \tmp1:=0 \ ENDIF
                playS(token,lloop):=playS(token,lloop)+tmp0
                flags(6):=TRUE
              ENDIF 
              IF flags(2)=TRUE THEN 
                PRINT MID$(playR(lloop),3,5); "+"; tmp0; " "; 
              ENDIF 
            NEXT lloop
            IF flags(2)=TRUE THEN  \ PRINT  \ ENDIF 
          ENDIF 
          IF playM(token,mloop)<40 THEN  \(* set RTB limit
            playP(token):=5
          ENDIF 
        ENDIF 
      NEXT mloop
      IF flags(6)=TRUE THEN 
        RETURN 
      ENDIF 
      tmp:=0 \tmp4:=0 \flags(6):=FALSE
      
      (* SRVY - range to nearest player
      range(token):=999 \target(token):=token
      FOR xloop=1 TO 8 \(* each pot. opponent
        IF token<>xloop THEN 
          tmp:=ABS(playX(xloop)-playX(token))
          tmp0:=ABS(playY(xloop)-playY(token))
          comp(xloop):=tmp+tmp0
        ENDIF 
      NEXT xloop
      FOR xloop=1 TO 8 \(* find closest player
        IF xloop<>token AND comp(xloop)<range(token) THEN 
          IF playP(token)<3 THEN 
            target(token):=xloop \range(token):=comp(xloop)
          ENDIF 
          IF playP(token)>2 AND playI(token)<>playI(xloop) THEN 
            target(token):=xloop \range(token):=comp(xloop)
          ENDIF 
        ENDIF 
      NEXT xloop
      IF playP(token)<2 THEN  \(* create plan
        IF playI(target(token))=playI(token) AND range(token)<5 THEN \(* set grouping 
          IF playP(target(token))=3 THEN 
            playP(token):=4 \leader(token):=target(token)
          ELSE 
            playP(token):=3 \playP(target(token)):=4
          ENDIF 
        ELSE 
          playP(token):=2
        ENDIF 
      ENDIF 
      ON playP(token) GOSUB 3001,3010,3010,3010,3040
      RETURN 
 3001 (* no plan
      tmp:=3 \tmp0:=tmp \(* set RTC spd
      GOSUB 9013
      IF playX(token)>32 THEN  \tmp:=tmp*-1 \ ENDIF 
      playX(token):=playX(token)+tmp
      IF playY(token)>32 THEN  \tmp0:=tmp0*-1 \ ENDIF 
      playY(token):=playY(token)+tmp
      GOSUB 9001 \ GOSUB 9014
      RETURN 
 3010 (* resolve plan
      tmp4:=0 \tcnt:=range(token)
      prnstr:=prnstr+"  "+STR$(range(token))+" to "
      prnstr:=prnstr+LEFT$(tribeN(ABS(playI(target(token)))),1)+":"+playN(target(token))+" "
      IF tcnt>24 THEN  \(* set chse dist 
        tmp4:=3 \ GOSUB 3040 \(* nobody close, drift to base
      ENDIF 
      IF tcnt<5 THEN  \(* set atk dist 
        IF playP(token)=2 OR playP(token)=4 THEN 
          IF playI(token)=playI(target(token)) THEN 
            prnstr:=prnstr+"formation."
          ELSE 
            prnstr:=prnstr+"attacking."
            tmp0:=target(token) \rlmt:=12-range(target(token))
            IF rlmt<1 THEN  \rlmt:=1 \ ENDIF 
            tmp1:=1 \tmp2:=12 \ GOSUB 9005
            rlmt:=5 \tmp0:=token \tmp1:=4 \tmp2:=6 \ GOSUB 9005 \(* set atkr dmg
          ENDIF 
        ENDIF 
      ELSE 
        IF playP(token)=2 OR playP(token)=3 THEN 
          testx:=playX(token) \testy:=playY(token) \ GOSUB 9013 \(* lift player
          tmp0:=playX(token) \tmp1:=playX(target(token))
          tmp2:=playY(token) \tmp3:=playY(target(token)) \tmp4:=3 \(* set chase spd
          GOSUB 9003 \testx:=glxX \testy:=glxY \ GOSUB 9014
          glxX:=testx \glxY:=testy
          playX(token):=testx \playY(token):=testy \(* drop player
          IF playI(token)<>playI(target(token)) THEN 
            IF playS(token,1)+playS(token,2)+playS(token,3)<150 THEN
              tmp4:=tmp4*1 \prnstr:=prnstr+"fleeing."
            ELSE 
              prnstr:=prnstr+"giving chase."
            ENDIF 
          ELSE 
            prnstr:=prnstr+"joining."
          ENDIF 
        ENDIF 
        IF playP(token)=3 THEN 
          FOR lloop=1 TO 8
            IF lloop<>token AND playI(target(token))=playI(token) THEN  \(* same endpoint all tribesmen
              testx:=playX(lloop) \testy:=playY(lloop) \ GOSUB 9013  \(* lift player
              tmp0:=playX(lloop) \tmp1:=playX(target(lloop))
              tmp2:=playY(lloop) \tmp3:=playY(target(lloop)) \tmp4:=1 \(* set folw spd
              GOSUB 9003 \testx:=glxX \testy:=glxY \ GOSUB 9014
              playX(lloop):=testx \playY(lloop):=testy \(* drop player
              rlmt:=3 \tmp0:=lloop \tmp1:=1 \tmp2:=3 \ GOSUB 9005 \(* set opp engine wear
            ENDIF 
          NEXT lloop
        ENDIF 
      ENDIF 
      rlmt:=4 \tmp0:=token \tmp1:=1 \tmp2:=3 \ GOSUB 9005 \(* set engine wear
 3039 IF flags(2)=TRUE THEN  \ PRINT prnstr \ ENDIF 
      RETURN 
      
 3040 (* return to base
      IF tmp4=0 THEN  \tmp4:=8 \ ENDIF  \(* set def.RTB spd
      testx:=playX(token) \testy:=playY(token) \(* lift player
      GOSUB 9013
      tmp0:=tribeX(ABS(playI(token))) \tmp1:=playX(token)
      tmp2:=tribeY(ABS(playI(token))) \tmp3:=playY(token)
      GOSUB 9003 \tribeX(token):=glxX \tribeY(token):=glxY
      testx:=playX(token) \testy:=playY(token) \ GOSUB 9014
      playP(token):=1 \playX(token):=testx \playY(token):=testy \(* drop player
      RETURN 
      
      (* Utility Stuffs ---------------
      
 9000 (* string concat
      gscan(glvl,testy):=LEFT$(gscan(glvl,testy),testx-1)+char+MID$(gscan(glvl,testy),testx+1,64)
      RETURN 
 9001 (* step right until clear
      testx:=testx-1
      LOOP 
        testx:=testx+1
        IF testx>64 THEN  \testx:=1 \testy:=testy+1 \ ENDIF 
        IF testy>64 THEN  \testy:=1 \ ENDIF 
      EXITIF MID$(gscan(1,testy),testx,1)=" " THEN 
      ENDEXIT 
      ENDLOOP 
      RETURN 
 9002 (* damage to players
      char:=MID$(gscan(1,glxY),glxX-1,3)
      IF char<>LEFT$(playN(token),1) THEN 
        IF SUBSTR(char,"abcdefghijklmnpqrstuvwxyz")>0 THEN 
          FOR play=1 TO 8
            IF LEFT$(playN(play),1)=char THEN 
              IF cmd=21 THEN (* phaser damage all warp powered systems
                rlmt:=dist \randl:=-1 \ GOSUB 9010
                dist0:=randl \cmd0:=63 \targ0:=1 \ GOSUB 2500 \(* shield & warp
                PRINT " Pulse result: "; randl; "% M/AM damage to "; playN(play); "."
                rlmt:=pin \randl:=0 \ GOSUB 9010
                dist0:=randl \cmd0:=63 \targ0:=4 \ GOSUB 2500 \(* shield & main
              ENDIF 
              IF cmd=22 THEN  \(* torpedo damage one random system
                rlmt=12 \randl:=-1 \ GOSUB 9010
                targ0:=randl \rlmt:=dist0 \randl:=0 \ GOSUB 9010
                cmd0:=63 \targ:=randl \ GOSUB 2500 \(* shield & random system 1-12
                PRINT " Torpedo result: "; randl; "% "; playR(targ); " damage to "; playN(play); "."
              ENDIF 
            ENDIF 
          NEXT play
        ENDIF 
      ELSE 
        IF SUBSTR(char,"*o@OQ")>0 THEN 
          rlmt:=10 \ GOSUB 9010
          IF randl<3 THEN 
            GOTO 9900 \(* player hits  something ***FIXME***
          ELSE 
            GOSUB 9001
          ENDIF 
        ENDIF 
      ENDIF 
      RETURN 
 9003 (* chase target: tmp0,1=play,targetX tmp2,3=and Y tmp4=step
      IF tmp0<tmp1 AND tmp0+tmp4<tmp1 THEN  \tmp0:=tmp0+tmp4 \ ENDIF
      IF tmp0>tmp1 AND tmp0-tmp4<tmp1 THEN  \tmp0:=tmp0-tmp4 \ ENDIF
      IF tmp2<tmp3 AND tmp2+tmp4<tmp3 THEN  \tmp2:=tmp2+tmp4 \ ENDIF
      IF tmp2>tmp3 AND tmp2-tmp4>tmp3 THEN  \tmp2:=tmp2-tmp4 \ ENDIF
      glxX:=tmp0 \glxY:=tmp2 \ GOSUB 9015
      testx:=glxX \testy:=glxY \ GOSUB 9001
      RETURN 
 9004 (* return empty testx,testy
      testx:=RND(63)+1 \testy:=RND(63)+1
      LOOP 
      EXITIF MID$(gscan(1,testy),testx,1)=" " THEN 
      ENDEXIT 
        testx:=testx+1
        IF testx>64 THEN  \testx:=1 \testy:=testy+1 \ ENDIF 
        IF testy>64 THEN  \testy:=1 \testx:=testx+1 \ ENDIF 
      ENDLOOP 
      RETURN 
 9005 (* return damage 
      FOR mloop=tmp1 TO tmp2
        randl:=2 \ GOSUB 9010
        playS(tmp0,mloop):=playS(tmp0,mloop)-randl
        IF flags(3)=TRUE THEN 
          PRINT MID$(playR(mloop),3,99); "-"; randl; "  ";  \(* debug
        ENDIF 
      NEXT mloop
      RETURN 
 9006 (* player scores
      FOR lloop=1 TO 8
        FOR xloop:=1 TO 3
          tint(xloop):=0
          FOR yloop=0 TO 10 STEP 3
            IF playS(lloop,xloop+yloop)<0 THEN 
              playS(lloop,xloop):=playS(lloop,xloop)-playS(lloop,xloop+yloop) \(* damage flows up
              playS(lloop,xloop+lloop):=0
            ENDIF 
            tint(xloop):=tint(xloop)+playS(lloop,xloop+yloop)
          NEXT yloop
        NEXT xloop
        IF cmd=32 THEN 
          PRINT 
          PRINT LEFT$(spaces,8-LEN(playN(yloop))); 
          PRINT playN(lloop); "   Reputatiom: "; ABS(playI(lloop)); 
          PRINT USING "3(s8>,i4<)","  M/AM: ",tint(1),"  Nuke: ",tint(2),"  Chem: ",tint(3)
        ENDIF 
        IF tint(3)<1 THEN 
          GOTO 9900
        ENDIF 
      NEXT lloop
      RETURN 
 9007 quadX:=INT((testx-1)/8+1) \quadY:=INT((testy-1)/8+1)
      RETURN 
 9008 (* read resouce layer
      tmp:=ASC(MID$(gscan(2,testy),testx,1)) \tint(1):=INT(tmp/100)
      tmp:=tmp-tint(1)*100 \tint(2):=INT(tmp/10) \tint(3):=tmp-tint(2)*10
      RETURN 
 9009 (* write resource layer
      char:=CHR$(tint(1)*100+tint(2)*10+tint(3))
      glvl:=2 \ GOSUB 9000 \glvl:=1
      RETURN 
 9010 (* convert random to randl with rlmt=limit 
      randl:=randl-1
      IF randl<0 THEN  \randl:=INT(MOD(random(3),rlmt)) \ ENDIF 
      IF randl>0 THEN  \randl:=INT(MOD(random(2),rlmt))
      ELSE  \randl:=INT(MOD(random(1),rlmt))
      ENDIF 
      RETURN 
 9011 IF flags(1)=TRUE THEN 
        PRINT  \ PRINT 
        FOR lloop:=1 TO 4 \tstr(lloop):=" "+LEFT$(tribeN(ABS(playI(lloop))),1)+" " \NEXT lloop
        PRINT USING "4(s9>,s4<)",playN(1),tstr(1),playN(2),tstr(2),playN(3),tstr(3),playN(4),tstr(4)
        FOR lloop:=1 TO 4 \tstr(lloop):=" "+LEFT$(tribeN(ABS(playI(lloop+4))),1)+" " \NEXT lloop
        PRINT USING "4(s9>,s4<)",playN(5),tstr(1),playN(6),tstr(2),playN(7),tstr(3),playN(8),tstr(4)
        PRINT spaces; "Tribes: "; trbname
        PRINT  \ PRINT sysname
      ENDIF 
      RETURN 
 9012 (* collision damage
      randl:=1 \rlmt:=12 \ GOSUB 9010 \targ0:=randl
      IF targ0>0 THEN 
        randl:=-1 \rlmt:=14 \ GOSUB 9010 \dist0:=randl \(* set coll dmg rlmt
        cmd0:=63 \play:=token \ GOSUB 2500
        PRINT " Collision damage "; dist0; "% to "; MID$(playR(targ0),3,5)
      ENDIF 
      RETURN 
 9013 (* lift player in:testx,testy
      char:=" " \glvl:=1 \ GOSUB 9000
      GOSUB 9008
      FOR mloop=1 TO 3
        rint(mloop):=tint(mloop) \tint(mloop):=0
      NEXT mloop
      GOSUB 9009
      RETURN 
 9014 (* drop player
      GOSUB 9007
      char:=LEFT$(playN(token),1) \ GOSUB 9000
      FOR mloop:=1 TO 3 \tint(mloop):=rint(mloop) \NEXT mloop
      GOSUB 9009
      RETURN 
 9015 (* wrap boundary. in/out glxX,glxY
      IF glxX<0 THEN  \glxX:=glxX+63 \glxY:=glxY-1 \ ENDIF 
      IF glxY<0 THEN  \glxY:=glxY+63 \glxX:=glxX-1 \ ENDIF 
      IF glxX<0 THEN glxX:=glxX+63 \ ENDIF 
      IF glxX>64 THEN  \glxX:=glxX-63 \glxY:=glxY+1 \ ENDIF 
      IF glxY>64 THEN  \glxY:=glxY-63 \glxX:=glxX+1 \ ENDIF 
      IF glxX>64 THEN glxX:=glxX-63 \ ENDIF 
      RETURN 
      
 9100 (* navigation
      PRINT spaces; "   8  1  2  "
      PRINT spaces; "    \ | /   "
      PRINT spaces; "  7 --+-- 3 "
      PRINT spaces; "    / | \   "
      PRINT spaces; "   6  5  4  "
      INPUT " Select course:",targ
      pin:=1 \ IF cmd<>23 THEN 
        INPUT " Distance(1-8): ",pin
      ENDIF 
      targ:=MOD(targ,9)
      pin:=MOD(pin,10)
      IF targ*pin=0 THEN  \ GOTO 9105 \ ENDIF 
      testx:=playX(token) \testy:=playY(token) \ GOSUB 9007
      tmpX:=quadX \tmpY:=quadY
      dist:=pin \(* tmp0=pri.system, tmp1=sec.system
      IF cmd=11 THEN 
        dist:=pin*5 \dmax:=64 \tmp0:=1 \tmp1:=4
      ENDIF 
      IF cmd=12 THEN 
        dist:=pin \dmax:=9 \tmp0:=2 \tmp1:=5
      ENDIF 
      IF cmd=21 THEN 
        dist:=pin*2 \dmax:=27 \tmp0:=5 \tmp1:=8
      ENDIF 
      IF cmd=22 THEN 
        dist:=pin*5 \dmax:=32 \tmp0:=5 \tmp1:=8
      ENDIF 
      IF cmd=23 THEN 
        dist:=1 \dmax:=2 \tmp0:=6 \tmp1:=9
      ENDIF 
      IF cmd=31 THEN 
        dist:=pin*5 \dmax:=64 \tmp0:=2 \tmp1:=8
      ENDIF 
      IF cmd=32 THEN 
        dist:=pin*5 \dmax:=64 \tmp0:=1 \tmp1:=10
      ENDIF 
      cmd0:=62 \play:=me \targ0:=tmp0 \ GOSUB 2500 \(* wear pri.system
      cmd0:=62 \play:=me \targ0:=tmp1 \ GOSUB 2500 \(* wear sec.system
      dtmp0:=playS(me,tmp0) \dtmp1:=playS(me,tmp1) \(* dtmp value those 2 systems
      dist:=INT(dist*(dtmp0/100)*(dtmp1/100)) \(* distance reduced by both systems
      IF dist>dmax THEN  \dist:=dmax \ ENDIF 
      ON targ GOSUB 9120,9121,9122,9123,9124,9125,9126,9127
      
      IF cmd=23 THEN  \dist:=1 \ ENDIF 
      FOR track=1 TO dist
        tmp0:=0 \glxX:=glxX+xstep \glxY:=glxY+ystep
        GOSUB 9015 \testx:=glxX \testy:=glxY \ GOSUB 9007
        IF cmd=12 OR cmd=22 THEN 
          IF tmpX<>quadX THEN  \glxX:=glxX-xstep \ GOTO 9105 \ ENDIF
          IF tmpY<>quadY THEN  \glxY:=glxY-ystep \ GOTO 9105 \ ENDIF
          IF MID$(gscan(1,glxY),glxX,1)<>" " THEN  \(* subwarp collision
            IF cmd=22 THEN  \ PRINT "Torpedo destroyed" \ GOTO 9105 \ ENDIF 
            IF cmd=12 THEN  \ GOSUB 9012 \ GOTO 9105 \ ENDIF 
          ENDIF 
        ENDIF 
      NEXT track
      IF cmd=11 THEN 
        IF scanx<>quadX OR scany<>quadY THEN  \(* might crash
          randl:=1 \rlmt:=10 \ GOSUB 9010
          IF randl<5 THEN 
            GOSUB 9012 \ GOTO 9105 \(* did crash
          ENDIF 
        ENDIF 
        scanx:=0 \scany:=0
      ENDIF 
 9105 IF tmpY<>quadY THEN  \glxY:=glxY-ystep \ ENDIF 
      GOSUB 2510
      RETURN 
      
 9120 xstep:=0 \ystep:=-1 \ RETURN 
 9121 xstep:=1 \ystep:=-1 \ RETURN 
 9122 xstep:=1 \ystep:=0 \ RETURN 
 9123 xstep:=1 \ystep:=1 \ RETURN 
 9124 xstep:=0 \ystep:=1 \ RETURN 
 9125 xstep:=-1 \ystep:=1 \ RETURN 
 9126 xstep:=-1 \ystep:=0 \ RETURN 
 9127 xstep:=-1 \ystep:=-1 \ RETURN 
      
 9900 (* death screen
      PRINT "You died!"
      PAUSE 
      END 
      
 9990 DATA "nimbus",-2,"wayfarer",-1,"hrtgold",-1,"axiom",-2,"eagle5",-3,"mfalcon",-3,"tardis7",-4
 9991 DATA "  Warp: ","% Impls:","%   RCS:","  Main: ","%   APU: ","%  Batt:","% Plse:","%  Torp:","% Miner:","  Shld: ","%  Envr:","% Consu:"
 9992 DATA "Antimatter (Warp, Main Pwr, Pulse, Shields)","Atomics (Impls, APU Pwr, Torpedos, Enviro)"
      DATA "Chemical (React, Batt Pwr, Mining, Consumable)"
 9993 DATA "*:nude star",350,"o:preciv",45,"@:suborbital",24,"O:orbital",8,"Q:galactic",4,"#:bases",4
 9994 DATA " Books"," Toons"," Film"," Human"," "," "," "," "
 9995 DATA "SRVY","CHSE","LEAD","WING","RTB","    "
