PROCEDURE consDump
      (* consDump26 - save file dump
      (* Trek skin -  initial
      DIM gscan(2,64):STRING[64]
      DIM tribeN(8),playN(8),playR(12):STRING[8]
      DIM planN(6):STRING[4]
      DIM sysname,filename:STRING[80]
      DIM teststr:STRING[16]
      DIM char:STRING[1]
      DIM playS(8,12),playM(8,3),playX(8),playY(8),playI(8),playC(8),playP(8),syst(6):INTEGER
      DIM tribeX(8),tribeY(8),target(8),leader(8),tint(3),rint(3):INTEGER
      DIM tmp,tmp0,tmp1,tmp2,testx,testy,lloop,mloop,xloop,yloop,glvl,token,rounds:INTEGER
      DIM path:BYTE
      DIM played(8),flags,hosted(8):BOOLEAN
      
      filename:="Trek.dat"
      PRINT "What is the name of this game ("; filename; ")"; 
      INPUT teststr
      IF teststr<>"" THEN  \filename:=teststr \ ENDIF 
      PRINT  \ PRINT "Dumping file..."
      OPEN #path,filename:READ
      FOR yloop=1 TO 64
        READ #path,gscan(1,yloop)
        PRINT gscan(1,yloop)
        IF MOD(yloop,16)=0 THEN  \ PRINT yloop;  \ INPUT a$ \ ENDIF
        IF MOD(yloop,64)=0 THEN  \ PRINT "next";  \ INPUT a$ \ ENDIF
      NEXT yloop
      FOR yloop=1 TO 64
        gscan(2,yloop):=""
        FOR mloop=1 TO 64
          READ #path,tmp
          gscan(2,yloop):=gscan(2,yloop)+CHR$(tmp)
          PRINT tmp; "."; 
          IF MOD(yloop,8)=0 THEN  \ PRINT  \ ENDIF 
        NEXT mloop
        PRINT "***"; yloop
        IF MOD(yloop,8)=0 THEN  \ PRINT yloop;  \ INPUT a$ \ ENDIF
      NEXT yloop
      PRINT 
 100  (* dump player data
      READ #path,token \ READ #path,rounds
      PRINT "Token:"; token; " Round: "; rounds
      FOR lloop=1 TO 8
        READ #path,playN(lloop) \ READ #path,playX(lloop) \ READ #path,playY(lloop)
        READ #path,playI(lloop) \ READ #path,playC(lloop) \ READ #path,playP(lloop)
        READ #path,target(lloop) \ READ #path,leader(lloop) \ READ #path,played(lloop)
        READ #path,hosted(lloop)
        PRINT playN(lloop); " X,Y="; playX(lloop); ","; playY(lloop); " Played? "; played(lloop)
        PRINT " Tribe:"; playI(lloop); " host by: "; hosted(lloop); " Score:"; playC(lloop)
        PRINT " Plan: "; playP(lloop); "Target:"; target(lloop); " Leader:"; leader(lloop)
        FOR yloop=1 TO 12 \ READ #path,playS(lloop,yloop)
          PRINT lloop; ":"; playS(lloop,yloop); 
        NEXT yloop
        PRINT  \ PRINT "Matl: "; 
        FOR yloop=1 TO 3 \ READ #path,playM(lloop,yloop)
          PRINT " "; lloop; ":"; playM(lloop,yloop); 
        NEXT yloop
        READ #path,tribeN(lloop) \ READ #path,tribeX(lloop) \ READ #path,tribeY(lloop)
        PRINT "Base:"; tribeN(lloop); " X,Y="; tribeX(lloop); ","; tribeY(lloop)
        INPUT a$
      NEXT lloop
      CLOSE #path
      END 
      
      
