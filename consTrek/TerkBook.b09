PROCEDURE consBook
      (* consBook feb12 - address book
      (* see TerkGame
      
      DIM commH(8):STRING[128] \(* site hostname
      DIM commN(8),commT(8):STRING[16] \(* chat name, phone num
      DIM commS(8):STRING[4] \(* site serial port
      DIM commI(8,4),lloop,site:INTEGER \(* site IP as 4 ints
      DIM commP(8):INTEGER \(* ephemeral port
      DIM teststr,teststr2,filename:STRING[32]
      DIM path:BYTE
      DIM flag:BOOLEAN
      teststr:="" \filename:="Terk"
      PRINT "What is the name of this game("; filename; ")";  \ INPUT teststr
      IF teststr<>"" THEN  \filename:=teststr \ ENDIF 
      ON ERROR GOTO 9960 \(* no file? make template
      OPEN #path,filename+".adr":UPDATE
 110  ON ERROR 
      GOSUB 9980 \(* read address file 
      GOSUB 9990 \(* print site table
      teststr:="y" \ INPUT "New site(y)? ",teststr
      IF teststr<>"n" THEN 
        FOR lloop=1 TO 8 \(* get next open slot
          IF commH(lloop)="none" THEN 115
        NEXT lloop
      ENDIF  \(* "y" or no free slots
      INPUT "Who to edit(1-8)? ",lloop
 115  site:=lloop
 120  PRINT "Using site "; site
      PRINT "Player's chat name ("; commN(site); ")";  \ INPUT teststr
      IF teststr<>"" THEN  \commN(site):=teststr \ ENDIF 
      teststr:=" "
      IF commH(site)="serial" THEN  \teststr:="s" \ ENDIF 
      PRINT "(s)erial or (n)etwork connection ("; teststr; ")"; 
      INPUT teststr
      IF teststr="n" THEN 
        PRINT "Hostname for site ("; commH(site); ")";  \ INPUT teststr
        IF teststr<>"" THEN  \commH(site):=teststr \ ENDIF 
 130    ON ERROR GOTO 130
        teststr2:=""
        FOR mloop=1 TO 4 \teststr2:=teststr2+STR$(commI(site,mloop))+"." \NEXT mloop
        PRINT "External IP address as dotted quad ("; teststr2; ") "; 
        INPUT teststr
        IF teststr<>"" THEN 
          teststr:=teststr+"."
          FOR mloop=1 TO 4
            tmp:=SUBSTR(".",teststr)
            commI(site,mloop):=VAL(LEFT$(teststr,tmp-1))
            teststr:=MID$(teststr,tmp+1,99)
          NEXT mloop
          ON ERROR 
          commP(site):=1
          PRINT "Ephemeral port 1-256 [we add 49152] ("; commP(site); ")"; 
          INPUT teststr \ IF teststr<>"" THEN  \commP(site):=VAL(teststr)
          ENDIF 
        ENDIF 
      ELSE 
        commS(site):="/t2"
        PRINT "Serial port("; commS(site); ")"; 
        INPUT teststr \ IF teststr<>"" THEN  \commS(site):=teststr \ ENDIF 
        commT(site):="direct"
        PRINT "Phone number as [1112223333] ("; commT(site); ")"; 
        INPUT teststr \ IF teststr<>"" THEN  \commT(site):=teststr \ ENDIF 
        commP(site):=0 \commH(site):="serial"
      ENDIF 
      GOSUB 9990 \ PRINT "(w)rite this, or (c)hange player "; commN(site); 
      INPUT teststr
      IF teststr="w" THEN 
        GOSUB 9970
      ELSE 
        flag:=TRUE \ SEEK #path,0 \ GOTO 120
      ENDIF 
      teststr:="n" \ INPUT "Run again (n)",teststr
      IF teststr="y" THEN 110
      CLOSE #path
      END 
      
 9960 (* init site table
      CREATE #path,filename+".adr":UPDATE
      FOR site=1 TO 8
        commN(site):="player"+STR$(site) \commH(site):="none"
        (* IF site=1 THEN \ commH(site):="localhost.localdomain" \ ENDIF
        commS(site):="    " \commP(site):=0 \commT(site):="          "
        FOR lloop=1 TO 4 \commI(site,lloop):=0 \NEXT lloop
      NEXT site
      GOSUB 9970 \(* write empty address file
      SEEK #path,0
      GOTO 110
      
 9970 (* write site table
      SEEK #path,0
      FOR site=1 TO 8
        WRITE #path,commN(site) \ WRITE #path,commH(site)
        WRITE #path,commS(site)
        FOR lloop=1 TO 4
          WRITE #path,commI(site,lloop)
        NEXT lloop
        WRITE #path,commP(site)
      NEXT site
      SEEK #path,0
      RETURN 
      
 9980 (* read site table
      FOR site=1 TO 8
        READ #path,commN(site) \ READ #path,commH(site) \
        READ #path,commS(site)
        FOR lloop=1 TO 4
          READ #path,commI(site,lloop)
        NEXT lloop
        READ #path,commP(site)
      NEXT site
      RETURN 
      
 9990 (* print site table
      PRINT 
      FOR mloop=1 TO 8
        PRINT  \ PRINT mloop; "   "; commN(mloop); ": "; commH(mloop); 
        IF commP(mloop)>0 THEN 
          PRINT " IP:"; 
          FOR lloop=1 TO 4
            PRINT commI(mloop,lloop); 
            IF lloop<4 THEN  \ PRINT ".";  \ ELSE PRINT ":";  \ ENDIF
          NEXT lloop
          PRINT commP(mloop)
        ENDIF 
        IF commH(mloop)="serial" THEN 
          PRINT " port:"; commS(mloop); "  phone: "; commT(mloop)
        ENDIF 
      NEXT mloop
      PRINT 
      RETURN 
      
